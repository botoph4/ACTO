{
  "id": "m1-three-wire-continuous-v1",
  "name": "M1 连续插3根线（单槽位中转台）",
  "description": "连续三根线的流水排程。假设中转台一次只缓存一根线，右臂可在左臂14s取线移动期间处理下一根，左臂拔帽和插接期间右臂被锁定。抓取多根线缆暂估0.5s。",
  "lanes": [
    {
      "id": "right_arm",
      "name": "右臂 / 搓线",
      "short_name": "R",
      "color": "#3978F6",
      "description": "右臂移动、抓取、搓线、放线和捋线"
    },
    {
      "id": "transfer",
      "name": "胸口中转台",
      "short_name": "T",
      "color": "#8B5CF6",
